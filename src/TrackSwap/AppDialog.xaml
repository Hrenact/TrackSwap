<Window x:Class="TrackSwap.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500"
        SizeToContent="Height"
        MaxHeight="640"
        MinHeight="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="Assets/TrackSwap.ico"
        Background="{StaticResource WindowBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="22,20" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="IconColumn" Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBorder"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="2"
                        CornerRadius="16">
                    <TextBlock x:Name="IconGlyph"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI"
                               FontSize="18"
                               FontWeight="SemiBold"
                               LineHeight="20"
                               TextAlignment="Center" />
                </Border>

                <ScrollViewer Grid.Column="1"
                              MaxHeight="390"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageText"
                               Margin="0,3,6,1"
                               FontSize="13"
                               LineHeight="21"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="14,12"
                Background="#161616"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel x:Name="ButtonPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
