<Window x:Class="TrackSwap.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TrackSwap.Controls" Title="TrackSwap" Icon="Assets/TrackSwap.ico" Width="1280" Height="820" MinWidth="960" MinHeight="660" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
    <Window.Resources>
        <DataTemplate x:Key="DeviceStatusOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusDisplayName}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="TargetStatusOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOnline}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Margin" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusDisplayName}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SidebarRouteItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBorderMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarNavigationButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavigationBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavigationBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavigationBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdvancedOptionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder" Width="17" Height="17" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                                <TextBlock x:Name="CheckMark" Text="✓" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBorderMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBorderMutedBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,24,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="TrackSwap" FontSize="18" FontWeight="Medium" />
                    <TextBlock Text="位姿映射" Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,24,0,24">
                    <Border x:Name="SteamVrBadge" Background="Transparent" Padding="0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SteamVrDot" Width="8" Height="8" Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SteamVrStatusText" Text="SteamVR" Margin="7,0,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="RuntimeBadge" Background="Transparent" Padding="0" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RuntimeDot" Width="8" Height="8" Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RuntimeStatusText" Text="Runtime" Margin="7,0,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid Grid.Row="2" Margin="7,0,1,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="配置列表" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="AddRouteButton" Content="＋ 新增" Padding="7,5" Background="Transparent" BorderThickness="0" Click="AddRouteButton_Click" />
                </Grid>
                <ListBox Grid.Row="3" x:Name="RouteListBox" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SidebarRouteItemStyle}" SelectionChanged="RouteListBox_SelectionChanged" PreviewMouseRightButtonDown="RouteListBox_PreviewMouseRightButtonDown" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding ProxyName}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="10" />
                                        <TextBlock Text=" · " Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="RenameRouteMenuItem" Header="重命名" Click="RenameRouteMenuItem_Click" />
                            <MenuItem x:Name="ToggleRouteMenuItem" Header="启用 / 停用" Click="ToggleRouteMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="DeleteRouteMenuItem" Header="删除配置…" Foreground="{StaticResource DestructiveBrush}" Click="DeleteRouteMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <Button Grid.Row="4" x:Name="SettingsNavigationButton" Content="设置" Style="{StaticResource SidebarNavigationButtonStyle}" HorizontalContentAlignment="Center" Click="SettingsNavigationButton_Click" />
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid x:Name="EmptyStateGrid" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                    <TextBlock Text="暂无配置，请新建。" FontSize="20" FontWeight="Medium" HorizontalAlignment="Center" />
                    <TextBlock Text="创建第一条路由后，可将物理位姿输出为虚拟追踪器，或替换现有设备的位姿。" Margin="0,8,0,18" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" />
                    <Button Content="＋ 新建配置" Style="{StaticResource PrimaryButton}" Padding="18,9" HorizontalAlignment="Center" Click="AddRouteButton_Click" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="RouteContentScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,26,32,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedProxyText" Text="PROXY-00" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="11" />
                            <TextBlock x:Name="SelectedRouteNameText" Text="新配置" Margin="0,4,0,0" FontSize="24" FontWeight="Medium" />
                            <TextBlock x:Name="SelectedRouteSummaryText" Text="选择来源与目标以完成配置。" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Background="Transparent" Padding="7">
                                <TextBlock x:Name="SelectedRouteStateText" Text="待应用" Foreground="{StaticResource WarningBrush}" FontSize="12" />
                            </Border>
                            <Button x:Name="ToggleSelectedRouteButton" Content="停用" Margin="9,0,0,0" Padding="13,7" Click="ToggleSelectedRouteButton_Click" />
                        </StackPanel>
                    </Grid>
                    <Border Margin="0,22,0,0" Padding="20" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="路由" FontSize="15" FontWeight="Medium" />
                                    <TextBlock Text="切换物理来源会立即生效，不需要重启 SteamVR。" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="RouteSyncText" Text="配置待同步" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" FontSize="11" />
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="运行模式" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <ComboBox x:Name="RuntimeModeComboBox" Margin="0,7,0,0" MinHeight="40" SelectionChanged="RuntimeModeSelection_Changed" />
                                    <TextBlock x:Name="RuntimeModeDescriptionText" Margin="2,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="物理位姿来源" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <ComboBox x:Name="RuntimeSourceComboBox" Margin="0,7,0,0" MinHeight="40" Tag="请选择" ItemTemplate="{StaticResource DeviceStatusOptionTemplate}" SelectionChanged="RuntimeSelection_Changed" />
                                    <TextBlock x:Name="RuntimeSourcePathText" Margin="2,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="RuntimeOutputPanel" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition x:Name="RuntimeTargetColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="RuntimeProxyPanel">
                                    <TextBlock Text="输出设备" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <Border Margin="0,7,0,0" MinHeight="40" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10">
                                        <TextBlock x:Name="RuntimeProxyText" Text="TRKSWAP-PROXY-00" VerticalAlignment="Center" FontFamily="Consolas" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="RuntimeTargetArrow" Grid.Column="1" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                <StackPanel x:Name="RuntimeTargetPanel" Grid.Column="2">
                                    <TextBlock Text="替换目标" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <ComboBox x:Name="RuntimeTargetComboBox" Margin="0,7,0,0" MinHeight="40" Tag="请选择" ItemTemplate="{StaticResource TargetStatusOptionTemplate}" SelectionChanged="RuntimeSelection_Changed" />
                                    <TextBlock x:Name="RuntimeTargetPathText" Margin="2,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="RuntimeControllerPanel" Margin="0,14,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="控制器侧别" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <ComboBox x:Name="RuntimeControllerHandComboBox" Margin="0,7,0,0" MinHeight="40" Tag="请选择" SelectionChanged="RuntimeSelection_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="控制输入来源" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <ComboBox x:Name="RuntimeControlInputComboBox" Margin="0,7,0,0" MinHeight="40" Tag="请选择" SelectionChanged="RuntimeSelection_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="输出设备" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <Border Margin="0,7,0,0" MinHeight="40" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10">
                                        <TextBlock x:Name="RuntimeControllerOutputText" Text="请选择控制器侧别" VerticalAlignment="Center" FontFamily="Consolas" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="RuntimeRouteChangeWarningText" Margin="0,10,0,0" Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,14,0,0" Padding="20" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="局部位姿偏移" FontSize="15" FontWeight="Medium" />
                                    <TextBlock Text="T_output = T_source × T_offset；OpenVR 右手系，+X 向右、+Y 向上、-Z 向前；单位为米。" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="重置为单位偏移" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" Click="ResetRuntimeOffsetButton_Click" />
                            </Grid>
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="位置 X（+右）" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <TextBox x:Name="OffsetTranslationXTextBox" Text="0" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="位置 Y（+上）" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <TextBox x:Name="OffsetTranslationYTextBox" Text="0" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="位置 Z（+后）" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <TextBox x:Name="OffsetTranslationZTextBox" Text="0" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="旋转 X" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <TextBox x:Name="OffsetRotationXTextBox" Text="0" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="旋转 Y" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <TextBox x:Name="OffsetRotationYTextBox" Text="0" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="10">
                                    <TextBlock Text="旋转 Z" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <TextBox x:Name="OffsetRotationZTextBox" Text="0" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="12">
                                    <TextBlock Text="旋转 W" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <TextBox x:Name="OffsetRotationWTextBox" Text="1" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button Content="重新读取" Click="RuntimeRefreshButton_Click" />
                                <Button x:Name="ApplyRuntimeButton" Content="应用更改" Style="{StaticResource PrimaryButton}" Margin="9,0,0,0" Click="ApplyRuntimeButton_Click" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.85*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="20" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="自动校准" FontSize="15" FontWeight="Medium" />
                                <TextBlock Text="使用参考设备计算安装偏移。" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBlock Text="档案名称" Margin="0,14,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                <TextBox x:Name="CalibrationNameTextBox" Margin="0,6,0,0" FontFamily="Microsoft YaHei UI" />
                                <TextBlock Text="参考目标" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                <ComboBox x:Name="CalibrationTargetComboBox" Margin="0,6,0,0" ItemTemplate="{StaticResource DeviceStatusOptionTemplate}" SelectionChanged="CalibrationSelection_Changed" />
                                <TextBlock Text="校准档案" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                <ComboBox x:Name="CalibrationProfileComboBox" Margin="0,6,0,0" SelectionChanged="CalibrationSelection_Changed" />
                                <TextBlock x:Name="CalibrationProfileDetailsText" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                <TextBlock x:Name="CalibrationStatusText" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button x:Name="DeleteCalibrationProfileButton" Content="删除档案" Click="DeleteCalibrationProfileButton_Click" IsEnabled="False" />
                                    <Button x:Name="ApplyCalibrationProfileButton" Content="应用档案" Margin="7,0,0,0" Click="ApplyCalibrationProfileButton_Click" IsEnabled="False" />
                                    <Button x:Name="CaptureCalibrationButton" Content="采集并应用" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" Click="CaptureCalibrationButton_Click" IsEnabled="False" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="20,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="3D 位姿预览" FontSize="15" FontWeight="Medium" />
                                        <TextBlock Text="左键平移 · 右键旋转 · 滚轮缩放" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="PreviewStatusText" Text="实时" Margin="0,0,10,0" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                        <Button Content="重置视图" Padding="9,4" Click="ResetPreviewViewButton_Click" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" x:Name="PreviewInteractionSurface" MinHeight="240" Background="#0F0F0F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" MouseDown="PosePreviewViewport_MouseDown" MouseMove="PosePreviewViewport_MouseMove" MouseUp="PosePreviewViewport_MouseUp" MouseWheel="PosePreviewViewport_MouseWheel" LostMouseCapture="PosePreviewViewport_LostMouseCapture">
                                    <Viewport3D x:Name="PosePreviewViewport" IsHitTestVisible="False">
                                        <Viewport3D.Camera>
