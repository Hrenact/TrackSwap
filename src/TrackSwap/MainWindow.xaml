            <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <Border x:Name="SteamVrBadge" Background="Transparent" Padding="0" ToolTip="{i18n:Loc Key=steamvr.status.not_running}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SteamVrDot" Width="7" Height="7" Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SteamVrStatusText" Text="SteamVR" Margin="6,0,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border x:Name="RuntimeBadge" Background="Transparent" Padding="0" Margin="18,0,0,0" ToolTip="{i18n:Loc Key=status_bar.runtime_badge_runtime_not_running}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RuntimeDot" Width="7" Height="7" Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RuntimeStatusText" Text="Runtime" Margin="6,0,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border x:Name="OscStatusBadge" Background="Transparent" Padding="0" Margin="18,0,0,0" ToolTip="{i18n:Loc Key=status_bar.osc_status_badge_osc_enable}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="OscStatusDot" Width="7" Height="7" Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="OscStatusText" Text="OSC" Margin="6,0,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border x:Name="XInputStatusBadge" Background="Transparent" Padding="0" Margin="18,0,0,0" ToolTip="{i18n:Loc Key=status_bar.xinput_status_badge_xinput_enable}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="XInputStatusDot" Width="7" Height="7" Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="XInputStatusText" Text="XInput" Margin="6,0,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border x:Name="PhysicalSourceHidingStatusBadge" Background="Transparent" Padding="0" Margin="18,0,0,0" ToolTip="{i18n:Loc Key=settings.advanced.hiding.disabled}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PhysicalSourceHidingStatusDot" Width="7" Height="7" Fill="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PhysicalSourceHidingStatusText" Text="{i18n:Loc Key=status_bar.physical_source_hiding_status_device_hide}" Margin="6,0,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        <Grid x:Name="DestructiveCleanupOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Panel.ZIndex="1000"
              Background="#F0000000"
              Focusable="True"
              Visibility="Collapsed">
            <Border Width="380"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="#704044"
                    BorderThickness="1"
                    CornerRadius="3">
                <StackPanel>
                    <TextBlock x:Name="DestructiveCleanupTitleText"
                               Text="{i18n:Loc Key=cleanup.in_progress_cleanup}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource DestructiveBrush}"
                               FontSize="16"
                               FontWeight="Medium" />
                    <TextBlock x:Name="DestructiveCleanupDescriptionText"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource DestructiveMutedBrush}"
                               FontSize="11"
                               Text="{i18n:Loc Key=cleanup.close_trackswap}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Border Width="120"
                            Height="2"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Background="{StaticResource DestructiveBrush}"
                            Opacity="0.65" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
