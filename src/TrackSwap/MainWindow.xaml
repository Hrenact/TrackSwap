                                <Border Padding="20" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock Text="显示头显、左手和右手目标" FontSize="15" FontWeight="Medium" />
                                        <TextBlock Text="开启后，可以直接把替换目标选为头显、左手或右手。SteamVR 可能把这些名称指向与你预期不同的实体设备。" Margin="0,4,0,16" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                        <CheckBox x:Name="ShowSteamVrRoleTargetsCheckBox" Style="{StaticResource AdvancedOptionCheckBoxStyle}" Content="在替换目标列表中显示头显、左手和右手" Click="ShowSteamVrRoleTargetsCheckBox_Click" />
                                        <TextBlock Text="TrackSwap 仍会阻止设备替换自己、循环替换和重复目标。旧配置不受此开关影响。" Margin="26,9,0,0" Foreground="{StaticResource WarningBrush}" FontSize="10" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="20" Margin="0,12,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock Text="3D 预览模型" FontSize="15" FontWeight="Medium" />
                                        <TextBlock Text="按需隐藏来源或目标模型。直接输出模式始终显示代理模型；目标替换模式可选择是否显示。" Margin="0,4,0,16" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                        <CheckBox x:Name="HideSourceInPreviewCheckBox" Style="{StaticResource AdvancedOptionCheckBoxStyle}" Content="隐藏来源模型" Click="PreviewModelVisibilityCheckBox_Click" />
                                        <CheckBox x:Name="HideTargetInPreviewCheckBox" Style="{StaticResource AdvancedOptionCheckBoxStyle}" Content="隐藏目标模型" Margin="0,10,0,0" Click="PreviewModelVisibilityCheckBox_Click" />
                                        <CheckBox x:Name="ShowProxyInPreviewCheckBox" Style="{StaticResource AdvancedOptionCheckBoxStyle}" Content="始终显示代理模型" Margin="0,10,0,0" Click="PreviewModelVisibilityCheckBox_Click" />
                                        <TextBlock Text="这些选项仅影响 TrackSwap 的 3D 预览，不改变路由、定位输出或 SteamVR 中的设备状态。" Margin="26,9,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="20" Margin="0,12,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0">
                                            <TextBlock Text="Runtime 启停行为" FontSize="15" FontWeight="Medium" />
                                            <TextBlock Text="决定后台定位服务什么时候运行。" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock Text="跟随 TrackSwap：打开软件时启动，退出软件时停止。&#x0a;跟随 SteamVR：启动 SteamVR 时运行，关闭 SteamVR 后停止；单独打开 TrackSwap 修改配置时也能正常使用。" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" x:Name="RuntimeLifecycleComboBox" VerticalAlignment="Center" SelectionChanged="RuntimeLifecycleComboBox_SelectionChanged" />
                                    </Grid>
                                </Border>
                                <Border Padding="20" Margin="0,12,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock Text="自动打开和关闭 TrackSwap" FontSize="15" FontWeight="Medium" />
                                        <TextBlock Text="启动 SteamVR 时自动打开 TrackSwap；关闭 SteamVR 后，完成待处理的配置更新便自动退出。" Margin="0,4,0,16" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                        <CheckBox x:Name="FollowSteamVrWithTrackSwapCheckBox" Style="{StaticResource AdvancedOptionCheckBoxStyle}" Content="让 TrackSwap 跟随 SteamVR 打开和关闭" Click="FollowSteamVrWithTrackSwapCheckBox_Click" />
                                        <TextBlock Text="启用后，TrackSwap 会出现在 SteamVR 的启动应用列表中，也可以在那里关闭自动启动。" Margin="26,9,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
                <ScrollViewer x:Name="MainScrollViewer" Height="0" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
