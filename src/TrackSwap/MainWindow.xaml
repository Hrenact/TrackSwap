<Window x:Class="TrackSwap.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TrackSwap.Controls" xmlns:i18n="clr-namespace:TrackSwap.Localization" i18n:Localize.Key="app.title" Icon="Assets/TrackSwap.ico" Width="1280" Height="820" MinWidth="960" MinHeight="660" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
    <Window.Resources>
        <DataTemplate x:Key="DeviceStatusOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusDisplayName}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="TargetStatusOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOnline}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Margin" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusDisplayName}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="XInputBindingOptionTemplate">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource TextBrush}"
                       Text="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <Style x:Key="SidebarRouteItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBorderMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarNavigationButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavigationBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavigationBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavigationBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GizmoSegmentButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegmentBackground" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBackground" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SegmentBackground" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdvancedOptionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder" Width="17" Height="17" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                                <TextBlock x:Name="CheckMark" Text="✓" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBorderMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBorderMutedBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.Column="0" Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,24,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock i18n:Localize.Key="route.list.title" FontSize="18" FontWeight="Medium" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="7,20,1,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RouteCountText" Text="00 / 16" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="AddRouteButton" i18n:Localize.Key="route.add" Padding="7,5" Background="Transparent" BorderThickness="0" Click="AddRouteButton_Click" />
                </Grid>
                <ListBox Grid.Row="2" x:Name="RouteListBox" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SidebarRouteItemStyle}" SelectionChanged="RouteListBox_SelectionChanged" PreviewMouseRightButtonDown="RouteListBox_PreviewMouseRightButtonDown" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding ProxyName}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="10" />
                                        <TextBlock Text=" · " Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="RenameRouteMenuItem" Header="{i18n:Loc Key=navigation.rename_route_menu_item}" Click="RenameRouteMenuItem_Click" />
                            <MenuItem x:Name="ToggleRouteMenuItem" Header="{i18n:Loc Key=navigation.toggle_route_menu_item_enable_disable}" Click="ToggleRouteMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="DeleteRouteMenuItem" Header="{i18n:Loc Key=route.action.delete_ellipsis}" Foreground="{StaticResource DestructiveBrush}" Click="DeleteRouteMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <Button Grid.Row="3" x:Name="SettingsNavigationButton" i18n:Localize.Key="nav.settings" Style="{StaticResource SidebarNavigationButtonStyle}" HorizontalContentAlignment="Center" Click="SettingsNavigationButton_Click" />
            </Grid>
        </Border>
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid x:Name="RuntimeLoadingStateGrid" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" MaxWidth="520">
                    <TextBlock Text="{i18n:Loc Key=startup.in_progress_read_config}" FontSize="20" FontWeight="Medium" HorizontalAlignment="Center" />
                    <TextBlock x:Name="RuntimeLoadingStateText"
                               Text="{i18n:Loc Key=startup.in_progress_connect_runtime_read_config}"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Grid x:Name="EmptyStateGrid" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                    <TextBlock i18n:Localize.Key="route.empty" FontSize="20" FontWeight="Medium" HorizontalAlignment="Center" />
                    <TextBlock Text="{i18n:Loc Key=startup.create_item_pose_output_virtual_tracker_replace_device_pose}" Margin="0,8,0,18" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" />
                    <Button Content="{i18n:Loc Key=startup.config}" Style="{StaticResource PrimaryButton}" Padding="18,9" HorizontalAlignment="Center" Click="AddRouteButton_Click" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="RouteContentScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,26,32,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedProxyText" Text="PROXY-00" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="11" />
                            <TextBlock x:Name="SelectedRouteNameText" Text="{i18n:Loc Key=route.default_name}" Margin="0,4,0,0" FontSize="24" FontWeight="Medium" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Background="Transparent" Padding="7">
                                <TextBlock x:Name="SelectedRouteSyncText" Text="{i18n:Loc Key=route.status.pending_apply}" Foreground="{StaticResource WarningBrush}" FontSize="12" />
                            </Border>
                            <Button x:Name="ToggleSelectedRouteButton" Content="{i18n:Loc Key=common.action.disable}" Margin="9,0,0,0" Padding="13,7" Click="ToggleSelectedRouteButton_Click" />
                        </StackPanel>
                    </Grid>
                    <Border Margin="0,22,0,0" Padding="20" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{i18n:Loc Key=route.editor.config}" FontSize="15" FontWeight="Medium" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <CheckBox x:Name="HidePhysicalSourceCheckBox"
                                              Style="{StaticResource AdvancedOptionCheckBoxStyle}"
                                              Content="{i18n:Loc Key=route.editor.hide_pose_source_device}"
                                              Visibility="Collapsed"
                                              Click="HidePhysicalSourceCheckBox_Click" />
                                    <CheckBox x:Name="SplitPoseSourceCheckBox"
                                              Style="{StaticResource AdvancedOptionCheckBoxStyle}"
                                              Content="{i18n:Loc Key=route.editor.source}"
                                              Margin="14,0,0,0"
                                              Click="SplitPoseSourceCheckBox_Click" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{i18n:Loc Key=route.editor.mode}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <ComboBox x:Name="RuntimeModeComboBox" Margin="0,7,0,0" MinHeight="40" Tag="{i18n:Loc Key=common.action.select}" SelectionChanged="RuntimeModeSelection_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{i18n:Loc Key=route.editor.position_source}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <ComboBox x:Name="RuntimeSourceComboBox" Margin="0,7,0,0" MinHeight="40" Tag="{i18n:Loc Key=common.action.select}" ItemTemplate="{StaticResource DeviceStatusOptionTemplate}" SelectionChanged="RuntimeSelection_Changed" />
                                    <TextBlock x:Name="RuntimeSourcePathText" Margin="2,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{i18n:Loc Key=route.editor.rotation_source}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <ComboBox x:Name="RuntimeRotationSourceComboBox" Margin="0,7,0,0" MinHeight="40" Tag="{i18n:Loc Key=route.rotation_source.same_as_position}" ItemTemplate="{StaticResource DeviceStatusOptionTemplate}" SelectionChanged="RuntimeSelection_Changed" />
                                    <TextBlock x:Name="RuntimeRotationSourcePathText" Margin="2,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="RuntimeOutputPanel" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition x:Name="RuntimeTargetColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="RuntimeProxyPanel">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{i18n:Loc Key=route.output_device}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <Grid Grid.Row="1" Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border MinHeight="40" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10">
                                            <TextBlock x:Name="RuntimeProxyText" Text="TRKSWAP-TRACKER-00" VerticalAlignment="Center" FontFamily="Consolas" />
                                        </Border>
                                        <Button x:Name="OpenSteamVrRoomSetupButton"
                                                Grid.Column="2"
                                                Content="{i18n:Loc Key=route.editor.open_steamvr_room_setup}"
                                                Padding="13,7"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed"
                                                Click="OpenSteamVrRoomSetupButton_Click" />
                                        <Button x:Name="OpenVrViewButton"
                                                Grid.Column="4"
                                                Content="{i18n:Loc Key=route.editor.open_vr_view}"
                                                Padding="13,7"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed"
                                                Click="OpenVrViewButton_Click" />
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="RuntimeTargetArrow" Grid.Column="1" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                <StackPanel x:Name="RuntimeTargetPanel" Grid.Column="2">
                                    <TextBlock Text="{i18n:Loc Key=route.editor.replacement_target}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <ComboBox x:Name="RuntimeTargetComboBox" Margin="0,7,0,0" MinHeight="40" Tag="{i18n:Loc Key=common.action.select}" ItemTemplate="{StaticResource TargetStatusOptionTemplate}" SelectionChanged="RuntimeSelection_Changed" />
                                    <TextBlock x:Name="RuntimeTargetPathText" Margin="2,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="RuntimeControllerPanel" Margin="0,14,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{i18n:Loc Key=route.editor.controller}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <ComboBox x:Name="RuntimeControllerHandComboBox" Margin="0,7,0,0" MinHeight="40" Tag="{i18n:Loc Key=common.action.select}" SelectionChanged="RuntimeSelection_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{i18n:Loc Key=route.editor.control_input_source}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <ComboBox x:Name="RuntimeControlInputComboBox" Margin="0,7,0,0" MinHeight="40" Tag="{i18n:Loc Key=common.action.select}" SelectionChanged="RuntimeSelection_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{i18n:Loc Key=route.output_device}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <Border Margin="0,7,0,0" MinHeight="40" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10">
                                        <TextBlock x:Name="RuntimeControllerOutputText" Text="{i18n:Loc Key=route.controller.select_hand}" VerticalAlignment="Center" FontFamily="Consolas" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="RuntimeRouteChangeWarningText" Margin="0,10,0,0" Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.85*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="20" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="PoseEditorTitleText" Text="{i18n:Loc Key=route.pose_offset.title}" FontSize="15" FontWeight="Medium" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{i18n:Loc Key=route.editor.reset}" Padding="9,4" Click="ResetRuntimeOffsetButton_Click" />
                                </Grid>
                                <TextBlock Text="{i18n:Loc Key=route.editor.position_centimetres}" Margin="0,16,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{i18n:Loc Key=route.editor.offset_translation_xtext_box_x_right}" FontSize="10" Foreground="#D46A6A"/><TextBox x:Name="OffsetTranslationXTextBox" Text="0" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="{i18n:Loc Key=route.editor.offset_translation_ytext_box_y_up}" FontSize="10" Foreground="#63C77A"/><TextBox x:Name="OffsetTranslationYTextBox" Text="0" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="{i18n:Loc Key=route.editor.offset_translation_ztext_box_z}" FontSize="10" Foreground="#5B9CFF"/><TextBox x:Name="OffsetTranslationZTextBox" Text="0" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                                <TextBlock Text="{i18n:Loc Key=route.editor.rotation_quaternion}" Margin="0,14,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Text="X" FontSize="10" Foreground="#D46A6A"/><TextBox x:Name="OffsetRotationXTextBox" Text="0" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Y" FontSize="10" Foreground="#63C77A"/><TextBox x:Name="OffsetRotationYTextBox" Text="0" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Row="2"><TextBlock Text="Z" FontSize="10" Foreground="#5B9CFF"/><TextBox x:Name="OffsetRotationZTextBox" Text="0" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="W" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/><TextBox x:Name="OffsetRotationWTextBox" Text="1" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="20,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{i18n:Loc Key=route.editor.3_d_pose_preview}" FontSize="15" FontWeight="Medium" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{i18n:Loc Key=route.preview.adjustment_tools}" Margin="0,0,9,0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" ToolTip="{i18n:Loc Key=route.editor.preview_show_position_rotation}" />
                                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="GizmoHiddenButton" Content="{i18n:Loc Key=route.editor.gizmo_hidden_hide}" Style="{StaticResource GizmoSegmentButtonStyle}" Click="GizmoHiddenButton_Click" />
