<Window x:Class="TrackSwap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrackSwap"
        Width="920"
        Height="610"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="23" FontWeight="SemiBold">
                        <Run Text="TrackSwap" FontFamily="Segoe UI" /><Run Text=" · 位姿映射" FontFamily="Microsoft YaHei UI" />
                    </TextBlock>
                    <TextBlock Text="SteamVR 位姿路由—— 选择谁提供定位，以及它要替换哪个设备的位姿。" Margin="0,3,14,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1" x:Name="RuntimeBadge" VerticalAlignment="Center" Background="#123225" CornerRadius="15" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RuntimeDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="RuntimeStatusText" Text="正在检测 SteamVR…" Foreground="{StaticResource SuccessBrush}" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34,28,34,24">
                <Border x:Name="EditorCardBorder" Padding="22" Background="#17212B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="3" Text="新增配置" FontSize="15" FontWeight="SemiBold" />

                        <StackPanel Grid.Row="1" Margin="0,18,0,0">
                            <TextBlock Text="追踪来源" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" FontSize="12" />
                            <ComboBox x:Name="SourceComboBox" Margin="0,9,0,0" MinHeight="42" SelectionChanged="Selection_Changed" />
                            <TextBlock x:Name="SourcePathText" Margin="2,8,0,0" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,18,0,0" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="23" />

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,18,0,0">
                            <TextBlock Text="替换目标" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" FontSize="12" />
                            <ComboBox x:Name="TargetComboBox" Margin="0,9,0,0" MinHeight="42" SelectionChanged="Selection_Changed" />
                            <TextBlock x:Name="TargetPathText" Margin="2,8,0,0" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11" />
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">
                            <Button x:Name="RefreshButton"
                                    Content="刷新"
                                    ToolTip="重新扫描设备并读取配置"
                                    Click="RefreshButton_Click" />
                            <Button x:Name="ApplyButton"
                                    Content="应用配置"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="10,0,0,0"
                                    Click="ApplyButton_Click"
                                    IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,22,0,0"
                        Padding="18"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="当前配置" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       x:Name="OverrideCountText"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="EmptyOverridesText"
                                   Margin="0,14,0,2"
                                   Text="当前没有位姿覆盖规则。"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <ItemsControl x:Name="OverridesItemsControl" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="12"
                                            Background="{StaticResource SurfaceRaisedBrush}"
                                            CornerRadius="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SourcePath}"
                                                               Margin="0,4,0,0"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="→"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding TargetPath}"
                                                               Margin="0,4,0,0"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <Button Content="编辑"
                                                        Tag="{Binding}"
                                                        Padding="10,6"
                                                        Click="EditOverrideButton_Click" />
                                                <Button Content="移除"
                                                        Tag="{Binding}"
                                                        Padding="10,6"
                                                        Margin="7,0,0,0"
                                                        Click="RemoveOverrideButton_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ViewRawButton" Content="定位配置文件" Padding="10,6" Click="LocateConfigButton_Click" />
                    <Button x:Name="RestoreBackupButton" Content="恢复备份" Padding="10,6" Margin="8,0,0,0" Click="RestoreBackupButton_Click" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="SettingsPathText" Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
