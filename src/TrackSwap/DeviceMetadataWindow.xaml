<Window x:Class="TrackSwap.DeviceMetadataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:TrackSwap.Localization"
        Width="520"
        Height="390"
        MinWidth="460"
        MinHeight="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Icon="Assets/TrackSwap.ico"
        Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,20">
                <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="Medium" />
                <TextBlock x:Name="IdentifierText"
                           Margin="0,6,0,18"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontFamily="Consolas"
                           FontSize="10"
                           TextWrapping="Wrap" />

                <TextBlock Text="{i18n:Loc Key=settings.devices.metadata.display_name}" />
                <TextBox x:Name="DisplayNameTextBox"
                         Margin="0,7,0,16"
                         MaxLength="64" />

                <TextBlock Text="{i18n:Loc Key=settings.devices.metadata.note}" />
                <TextBox x:Name="NoteTextBox"
                         Margin="0,7,0,0"
                         Height="104"
                         MaxLength="256"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Padding="14,12"
                Background="#161616"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{i18n:Loc Key=dialog.cancel}"
                        MinWidth="78"
                        IsCancel="True" />
                <Button Content="{i18n:Loc Key=settings.devices.metadata.save}"
                        MinWidth="78"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
